{
  "name": "foodtrucks-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.21",
    "@expo/vector-icons": "^15.0.2",
    "@rnmapbox/maps": "^10.3.11",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "^1.21.5",
    "prettier": "3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client --localhost",
    "android": "expo run:android --device",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "check:dependencies": "expo install --check",
    "doctor": "expo-doctor",
    "test": "node --experimental-strip-types --test src/features/discovery/catalog.test.ts",
    "format": "prettier --write src plugins app.json package.json tsconfig.json eslint.config.cjs .prettierrc.json",
    "format:check": "prettier --check src plugins app.json package.json tsconfig.json eslint.config.cjs .prettierrc.json",
    "postinstall": "node scripts/dependency-patches.mjs",
    "security:check": "node scripts/dependency-patches.mjs --check",
    "security:test": "node --test scripts/dependency-security.test.mjs",
    "security:audit": "npm run security:check && npm run security:test && node scripts/audit-security.mjs"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "^24.3.0",
    "npm": "^11.0.0"
  },
  "type": "module",
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
